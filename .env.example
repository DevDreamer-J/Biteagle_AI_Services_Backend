# 复制为 .env 后按需修改（.env 不入库）
ENVIRONMENT=local
DEBUG=false

LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL（本机直接运行用 localhost；容器内由 compose 注入 postgres）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ（Celery broker）
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# 限流（每个 API Key / IP 每分钟请求数）
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
# 幂等键缓存 TTL（秒）
IDEMPOTENCY_TTL_SECONDS=86400
